{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://bantru-nodejs-fkhde9htaae7h5fm.southeastasia-01.azurewebsites.net/api/:path*"
    },
    {
      "source": "/login/",
      "destination": "https://bantru-nodejs-fkhde9htaae7h5fm.southeastasia-01.azurewebsites.net/login/"
    },
    {
      "source": "/logout/",
      "destination": "https://bantru-nodejs-fkhde9htaae7h5fm.southeastasia-01.azurewebsites.net/logout/"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
